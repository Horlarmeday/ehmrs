{
  "name": "@ehmrs/type-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "ADR-0004 type pipeline — request types from server Joi/interfaces, response types inferred from fixture corpus (issue #39)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "tsc -p tsconfig.json && node dist/cli.js",
    "check": "tsc -p tsconfig.json && node dist/cli.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
